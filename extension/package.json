{
  "name": "minimum-paypal-web-extension-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "lint": "oxlint --type-aware --fix && eslint --fix",
    "postinstall": "wxt prepare",
    "stylelint": "stylelint . --fix",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@minimum-paypal/shared": "workspace:*",
    "@firebase/app": "^0.15.0",
    "@firebase/auth": "^1.13.3",
    "@webext-core/messaging": "^3.0.2",
    "convex": "^1.42.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.6.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "postcss": "^8.5.16",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.3",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wxt": "^0.20.27"
  },
  "packageManager": "pnpm@11.1.2"
}
