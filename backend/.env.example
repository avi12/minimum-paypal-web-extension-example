# Set by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment

# Firebase-issued ID tokens use this value for both project ID and audience.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google OAuth web client. Keep the secret only in Convex deployment env vars.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_CALLBACK_URL=https://your-deployment.convex.site/oauth/google/callback

# Exact comma-separated redirect URIs accepted by Google OAuth start/exchange.
EXTENSION_REDIRECT_URIS=https://CHROME_EXTENSION_ID.chromiumapp.org/,https://FIREFOX_REDIRECT_HOST.extensions.allizom.org/

# PayPal REST app credentials for this deployment. Use sandbox values on a
# development deployment and a separate Live app/webhook on production.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_RETURN_URL=https://your-deployment.convex.site/paypal/return
PAYPAL_CANCEL_URL=https://your-deployment.convex.site/paypal/cancel
